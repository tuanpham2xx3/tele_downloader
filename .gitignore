# Chrome profile contains local sessions and private browsing data.
Chrome_Telegram_Profile/

# Local Python environment and encrypted Telegram credentials.
.venv/
.runtime/
.telerecon-credentials.xml
__pycache__/
*.pyc

# User-generated URL exports and status CSV.
telegram-get-files-*.txt
*.log
*.lock
telegram_media_downloader/full_hoahoc.csv
telegram_media_downloader/temp_*/
*.session
telegram_media_downloader/*.session

# Google OAuth desktop credentials must never be committed.
client_secret_*.apps.googleusercontent.com.json

# Telegram Credentials (Hoặc tự động nạp từ .telerecon-credentials.xml)
TELERECON_API_ID=your_api_id
TELERECON_API_HASH=your_api_hash
TELERECON_PHONE=+84901234567

# Bot Telegram Target
TARGET_CHAT=@coursebusters_bot

# Cấu hình Rclone Google Drive (URL / Thư mục cha trên Google Drive)
# Ví dụ: gdrive:/COURSES_FOLDER hoặc drive_id:MyCourses
RCLONE_PARENT_FOLDER=gdrive:/COURSES_FOLDER

# Thư mục tạm & File dữ liệu
TEMP_DIR=./temp_processing
CSV_PATH=./full_hoahoc.csv
LOG_FILE=./pipeline.log

# Cổng Web theo dõi Log từ xa (Truy cập: http://IP_UBUNTU:5000)
WEB_LOG_PORT=5000

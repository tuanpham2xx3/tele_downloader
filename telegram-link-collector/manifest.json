{
  "manifest_version": 3,
  "name": "Telegram Get Files URL Collector",
  "version": "1.6.0",
  "description": "Collects Get Files links and opens their Telegram bots in Telegram Web.",
  "permissions": ["activeTab", "downloads", "scripting", "tabs"],
  "host_permissions": [
    "https://www.cbusters.com/*",
    "https://t.me/*",
    "https://web.telegram.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Collect Get Files URLs"
  }
}
